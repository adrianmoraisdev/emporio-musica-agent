# Copy to .env and fill in. The .env file is git-ignored.

# Provider: anthropic (default) | gemini | openai-compat (e.g. local Ollama)
EMPORIO_PROVEDOR=anthropic

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Gemini API key, free tier available (https://aistudio.google.com/)
GEMINI_API_KEY=

# Model (leave empty for the provider default: claude-opus-5-5 / gemini-3.5-flash).
# Effort (low | medium | high) applies to Anthropic only; "low" keeps chat replies fast.
EMPORIO_MODELO=
EMPORIO_ESFORCO=low

# Simulated "today". Orders in the dataset go up to March 2026; pinning the date keeps
# order statuses and return deadlines consistent. Remove it to use the real date.
EMPORIO_HOJE=2026-03-25
