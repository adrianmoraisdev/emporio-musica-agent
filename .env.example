# Copy to .env and fill in. The .env file is git-ignored.

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model and effort level (low | medium | high). "low" keeps chat replies fast.
# Use claude-haiku-5-5 for a cheaper run.
EMPORIO_MODELO=claude-opus-5-5
EMPORIO_ESFORCO=low

# Simulated "today". Orders in the dataset go up to March 2026; pinning the date keeps
# order statuses and return deadlines consistent. Remove it to use the real date.
EMPORIO_HOJE=2026-03-25
