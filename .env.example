# Copie para .env e preencha. O .env não é versionado.

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo e nível de esforço (low | medium | high). "low" dá respostas rápidas de chat.
EMPORIO_MODELO=claude-opus-5-5
EMPORIO_ESFORCO=low

# Data "de hoje" usada pelo agente. Os pedidos do dataset vão até mar/2026; fixar a data
# deixa status e prazos de troca coerentes. Apague para usar a data real.
EMPORIO_HOJE=2026-03-25
